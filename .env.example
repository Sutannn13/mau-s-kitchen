# =====================================================
# MAU'S Kitchen — Environment Variables
# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit file .env.local ke repository.
# =====================================================

# --- Situs -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="MAU'S Kitchen"

# --- WhatsApp ----------------------------------------
# Format internasional tanpa tanda + dan tanpa spasi
NEXT_PUBLIC_WHATSAPP_NUMBER=6281617691585
NEXT_PUBLIC_WHATSAPP_DISPLAY=0816-1769-1585

# --- Pembayaran --------------------------------------
NEXT_PUBLIC_QRIS_IMAGE_PATH=/assets/payment/qris.png
NEXT_PUBLIC_BANK_NAME=BCA
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=TBD
NEXT_PUBLIC_BANK_ACCOUNT_NAME=TBD

# --- Supabase (Fase 2) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA — hanya dipakai di server. Jangan beri prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Operasional (opsional) --------------------------
NEXT_PUBLIC_BUSINESS_HOURS="TBD"
NEXT_PUBLIC_BUSINESS_ADDRESS="TBD"
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Payment gateway (Fase 3, opsional) --------------
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
